BLOCKED="PLAN.md|SESSION_SUMMARY.md|decision-memo.md|LAUNCH_POSTS.md|docs/launch_plan_|docs/hn_feedback_log.md|docs/tracking/"
STAGED=$(git diff --cached --name-only)
